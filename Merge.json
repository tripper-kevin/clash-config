{
  "geodata-mode": true,
  "geox-url": {
    "geoip": "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip.dat",
    "geosite": "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geosite.dat",
    "mmdb": "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip.metadb",
    "asn": "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/GeoLite2-ASN.mmdb"
  },
  "geo-auto-update": true,
  "geo-update-interval": 24,
  "ntp": {
    "enable": false
  },
  "sniffer": {
    "enable": false
  },
  "rule-providers": {
    "anti-ad": {
      "type": "http",
      "behavior": "domain",
      "format": "mrs",
      "url": "https://anti-ad.net/mihomo.mrs",
      "interval": 86400
    },
    "academic-tools": {
      "type": "http",
      "behavior": "classical",
      "format": "yaml",
      "url": "https://raw.githubusercontent.com/tripper-kevin/clash-config/main/rules/AcademicTools.yaml",
      "interval": 86400
    }
  },
  "dns": {
    "enable": true,
    "listen": "127.0.0.1:53",
    "enhanced-mode": "fake-ip",
    "fake-ip-range": "198.18.0.1/16",
    "fake-ip-range6": "2001:2::0/64",
    "fake-ip-filter-mode": "blacklist",
    "prefer-h3": false,
    "respect-rules": false,
    "use-hosts": true,
    "use-system-hosts": true,
    "ipv6": true,
    "fake-ip-filter": [
      "*.lan",
      "*.local",
      "*.localhost",
      "*.arpa",
      "time.*.com",
      "ntp.*.com",
      "+.msftconnecttest.com",
      "+.msftncsi.com",
      "+.tsinghua.edu.cn",
      "+.qq.com",
      "rule-set:anti-ad"
    ],
    "default-nameserver": [
      "system"
    ],
    "nameserver": [
      "https://dns.alidns.com/dns-query",
      "https://doh.pub/dns-query"
    ],
    "direct-nameserver-follow-policy": true,
    "direct-nameserver": [
      "system"
    ],
    "nameserver-policy": {
      "rule-set:anti-ad": "rcode://name_error",
      "+.tsinghua.edu.cn": [
        "system"
      ]
    }
  },
